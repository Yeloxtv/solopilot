{
  "name": "solopilot",
  "version": "0.2.0",
  "description": "Project steering for solo developers: a versioned backlog, an honest projection, a dashboard and a Slack digest, wired into Claude Code.",
  "type": "module",
  "license": "MIT",
  "author": "Yeloxtv",
  "repository": { "type": "git", "url": "git+https://github.com/Yeloxtv/solopilot.git" },
  "homepage": "https://github.com/Yeloxtv/solopilot#readme",
  "keywords": ["claude-code", "project-management", "solo-developer", "freelance", "agency", "forecasting", "backlog", "dashboard", "planning", "cli"],
  "bin": { "solopilot": "bin/solopilot.mjs" },
  "files": ["bin", "src", "locales", "templates", "claude", "examples/demo/solopilot.yaml", "examples/demo/sources", "examples/demo-fr/solopilot.yaml", "examples/demo-fr/sources"],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test",
    "demo": "node bin/solopilot.mjs build --dir examples/demo --today 2026-10-21",
    "demo:fr": "node bin/solopilot.mjs build --dir examples/demo-fr --today 2026-10-21",
    "e2e": "node e2e/run.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": { "yaml": "^2.5.0" }
}
